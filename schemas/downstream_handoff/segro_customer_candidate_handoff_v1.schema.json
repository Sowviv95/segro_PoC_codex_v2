    "status": {"enum": ["accepted", "accepted_with_caveat", "abstained", "rejected"]},
    "target_id": {"type": "string"},
    "trace_id": {"type": "string"},
    "transformation_status": {"type": "string"}
  },
  "required": [
    "schema_version", "trace_id", "asset_record_key", "requirement_id",
    "target_id", "field_name", "customer_field_label", "display_value",
    "status", "reason_code", "caveat", "source_reference",
    "internal_record_identity", "transformation_status"
  ],
  "schema_name": "segro_customer_candidate_handoff_v1",
  "schema_version": "1",
  "type": "object"
}
