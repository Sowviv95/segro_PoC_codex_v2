{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["abstained", "rejected"]}}},
      "then": {"properties": {"display_value": {"type": "null"}}}
    }
  ],
  "contract_version": "1.0.0",
  "properties": {
    "asset_record_key": {"type": ["string", "null"]},
    "caveat": {"type": ["string", "null"]},
    "customer_field_label": {"type": ["string", "null"]},
    "display_value": {"type": ["string", "number", "boolean", "null"]},
    "field_name": {"type": "string"},
    "internal_record_identity": {"type": "string"},
    "reason_code": {"type": "string"},
    "requirement_id": {"type": "string"},
    "schema_version": {"const": "segro_customer_candidate_handoff_v1"},
    "source_reference": {
      "additionalProperties": true,
      "properties": {
        "page_number": {"type": ["integer", "null"]},
        "source_file": {"type": ["string", "null"]},
        "source_id": {"type": ["string", "null"]},
        "source_url": {"type": "null"},
